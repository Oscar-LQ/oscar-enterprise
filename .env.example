# Oscar runtime environment template.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
#
# Oscar's runtime LLM is model-agnostic by design (PROJECT.md § LLM Policy).
# Provider, model, and key are injected at startup — not hardcoded.
#
# Per-agent model allocation: each agent/role reads its own env-var triple,
# sourced via src/llm/chat_model.py:get_chat_model(env_prefix="..."). See
# ADR 010 for the allocation rationale and ADR 011 for the MiniMax wiring.
# See docs/secrets.md for provenance on every var below.

# ---- Default / single-agent slot (Sprints 3-6) ----
# Used by experiments that call `get_chat_model()` without an env_prefix:
#   - src/experiments/sprint-03-minimax-call/hello_llm.py
#   - src/experiments/sprint-06-deep-agents-runs/hello_deep_agent.py
# Supported providers: minimax, openrouter.
OSCAR_LLM_PROVIDER=openrouter
OSCAR_LLM_MODEL=openai/gpt-5.4
OSCAR_LLM_API_KEY=your-key-here

# ---- Sprint M3+ — Oscar (front-door orchestrator) ----
# Oscar — the LangChain agent at the front door (ADR 026). Frontier
# reasoning model; tool-calling orchestration. Replaces the M2 General
# Counsel chain at this layer.
OSCAR_LLM_OSCAR_PROVIDER=openrouter
OSCAR_LLM_OSCAR_MODEL=openai/gpt-5.5
OSCAR_LLM_OSCAR_API_KEY=your-openrouter-key-here

# ---- Sprint M3+ — Redline pipeline (10P, wrapped as the redline_nda tool) ----
# The 10P planner-executor pipeline (ADR 019, ADR 027). Two LLMs split
# by role (ADR 020 plan data contract): planner emits structured per-
# change decisions, executor produces byte-precise text per counter-
# propose. Promoted from feature-branch-only to main in M3 alongside
# the LangChain tool wrapper.
OSCAR_LLM_REDLINE_PLANNER_PROVIDER=openrouter
OSCAR_LLM_REDLINE_PLANNER_MODEL=openai/gpt-5.5
OSCAR_LLM_REDLINE_PLANNER_API_KEY=your-openrouter-key-here

OSCAR_LLM_REDLINE_EXECUTOR_PROVIDER=minimax
OSCAR_LLM_REDLINE_EXECUTOR_MODEL=MiniMax-M2.7
OSCAR_LLM_REDLINE_EXECUTOR_API_KEY=your-minimax-key-here

# ---- Sprint 7-9 per-role slots — kept live for the practice-area-heads sprint ----
# Head of Commercial — first practice-area head (later sprint per M3
# plan § 9). Deep Agent harness with subagent delegation (ADR 014, ADR
# 029). Capable-but-cheaper model.
OSCAR_LLM_HEAD_OF_COMMERCIAL_PROVIDER=minimax
OSCAR_LLM_HEAD_OF_COMMERCIAL_MODEL=MiniMax-M2.7
OSCAR_LLM_HEAD_OF_COMMERCIAL_API_KEY=your-minimax-key-here

# Accept/reject reasoner — functional specialist under Head of Commercial
# (Sprint 9). Specialist-tier per ADR 010; typically same provider/key as HOC.
OSCAR_LLM_ACCEPT_REJECT_REASONER_PROVIDER=minimax
OSCAR_LLM_ACCEPT_REJECT_REASONER_MODEL=MiniMax-M2.7
OSCAR_LLM_ACCEPT_REJECT_REASONER_API_KEY=your-minimax-key-here

# ---- UNUSED as of M3 — slated for deletion in housekeeping sprint ----
# General Counsel — superseded by Oscar (ADR 026). Kept so deployments
# that have not yet rotated can still parse this file without errors;
# delete in the housekeeping sprint that addresses the missing ADR 001.
OSCAR_LLM_GENERAL_COUNSEL_PROVIDER=openrouter
OSCAR_LLM_GENERAL_COUNSEL_MODEL=openai/gpt-5.4
OSCAR_LLM_GENERAL_COUNSEL_API_KEY=your-openrouter-key-here

# Redline specialist — superseded by the planner/executor split (ADR 019,
# ADR 020) since Sprint 10O. Kept until the housekeeping sprint.
OSCAR_LLM_REDLINE_SPECIALIST_PROVIDER=minimax
OSCAR_LLM_REDLINE_SPECIALIST_MODEL=MiniMax-M2.7
OSCAR_LLM_REDLINE_SPECIALIST_API_KEY=your-minimax-key-here

# MiniMax: MiniMax-M2.7 (also: MiniMax-M2, MiniMax-M2.5, *-highspeed variants)
# OpenRouter: <vendor>/<model>, e.g. openai/gpt-5.4, anthropic/claude-3.5-sonnet

# ---- Sprint M2: Slack channel ----
# Slack-bolt Socket Mode connection. The bot token (xoxb-) authenticates
# chat.postMessage; the app token (xapp-) authenticates the Socket Mode
# WebSocket handshake. Real values live in /etc/oscar/oscar.env on the
# host (read-only bind-mount per ADR 025); see docs/secrets.md.
OSCAR_SLACK_BOT_TOKEN=xoxb-your-bot-token-here
OSCAR_SLACK_APP_TOKEN=xapp-your-app-token-here

# ---- Sprint M2: AgentMail channel (deferred — credentials not yet provisioned) ----
# AgentMail provides an outbound-only WebSocket transport for inbound email
# (https://docs.agentmail.to/websockets); no public endpoint required from
# the sandbox. The API key is workspace-scoped (single key, not per-inbox);
# the inbox id selects which inbox the runtime listens on. Real values land
# in /etc/oscar/oscar.env on the host (read-only bind-mount per ADR 025);
# see docs/secrets.md.
OSCAR_AGENTMAIL_API_KEY=your-agentmail-workspace-api-key-here
OSCAR_AGENTMAIL_INBOX_ID=your-agentmail-inbox-id-here
