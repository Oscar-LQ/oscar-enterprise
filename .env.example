# Oscar runtime environment template.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
#
# Oscar's runtime LLM is model-agnostic by design (PROJECT.md § LLM Policy).
# Provider, model, and key are injected at startup — not hardcoded.

# Which provider to dispatch to. Supported values: minimax
# Future sprints will add: openrouter, anthropic, openai, ...
OSCAR_LLM_PROVIDER=minimax

# Provider-specific model identifier.
# MiniMax: MiniMax-M2.7 (also: MiniMax-M2, MiniMax-M2.5, *-highspeed variants)
OSCAR_LLM_MODEL=MiniMax-M2.7

# API key for the selected provider.
OSCAR_LLM_API_KEY=your-key-here
